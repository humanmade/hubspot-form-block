{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "chek/hubspot-form",
	"version": "0.5.1",
	"title": "Chek Hubspot Form",
	"category": "embed",
	"icon": "clipboard",
	"attributes": {
		"portalId": {
			"type": [ "integer", "null" ],
			"default": null
		},
		"region": {
			"type": "string",
			"enum": [ "eu1", "na1" ],
			"default": "eu1"
		},
		"formId": {
			"type": "string",
			"default": ""
		},
		"redirectUrl": {
			"type": "string"
		},
		"submitText": {
			"type": "string"
		},
		"inlineMessage": {
			"type": "string"
		},
		"gtmEventName": {
			"type": "string"
		},
		"persistSuccess": {
			"type": "boolean",
			"default": false
		},
		"businessUnitId": {
			"type": [ "integer", "null" ],
			"default": null
		},
		"formVersion": {
			"type": "string",
			"enum": [ "v4", "v2" ],
			"default": "v4"
		}
	},
	"description": "Chek Hubspot Form embed block with configuration options",
	"supports": {
		"html": false,
		"align": true,
		"alignWide": true,
		"customClassName": true,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"anchor": true
	},
	"textdomain": "chek-hubspot-form-block",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": [ "file:./view.js", "hs-forms" ],
	"render": "file:./render.php"
}
